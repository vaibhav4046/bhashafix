# Vercel builds from source, so none of this needs uploading. Without this file
# the CLI uploads node_modules and every build output in the workspace, which is
# well over a gigabyte and fails the upload outright.

node_modules
**/node_modules

# Build output — regenerated by the build step.
.next
**/.next
.vinext
dist
packages/*/dist
out
**/out

# Local runtime state and receipts. Gitignored, machine-specific, not shipped.
.bhashafix
artifacts
.tmp
.tmp-contract-check
.npm-cache
.wrangler

# .openai is NOT excluded: vite.config.ts imports ./.openai/hosting.json and the
# Next build type-checks that file, so removing it fails the build.

# Test output.
playwright-report
test-results
coverage

# The Next.js repair fixture is scanned locally; it is not part of the site.
fixtures/nextjs-app/.next
fixtures/nextjs-app/out
fixtures/nextjs-app/node_modules

.git
