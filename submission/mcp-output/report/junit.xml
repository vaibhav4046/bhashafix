nish glossary.">translations.es-MX.checkout.term === glossary.Checkout.es-MX</failure></testcase><testcase classname="wrong-page-lang" name="BF-META-EN-010"><failure message="The source page declares a generic language instead of the configured source locale.">localeState.pageLang === &quot;en-GB&quot;</failure></testcase></testsuite>
