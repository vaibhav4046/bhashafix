{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "BhashaFix",
          "version": "0.2.0",
          "rules": [
            {
              "id": "vertical-clipping",
              "shortDescription": {
                "text": "Devanagari glyph bounds exceed the available line box."
              }
            },
            {
              "id": "cta-overflow",
              "shortDescription": {
                "text": "The German CTA scroll width exceeds its fixed client width."
              }
            },
            {
              "id": "wrong-direction",
              "shortDescription": {
                "text": "The Arabic route is rendered left-to-right."
              }
            },
            {
              "id": "rtl-icon-order",
              "shortDescription": {
                "text": "The directional icon remains after the label in RTL."
              }
            },
            {
              "id": "raw-translation-key",
              "shortDescription": {
                "text": "A raw translation key is visible in the checkout action."
              }
            },
            {
              "id": "font-coverage",
              "shortDescription": {
                "text": "The configured font stack does not cover the Simplified Chinese specimen."
              }
            },
            {
              "id": "line-breaking",
              "shortDescription": {
                "text": "Thai content is forced onto one line and overflows its container."
              }
            },
            {
              "id": "placeholder-mismatch",
              "shortDescription": {
                "text": "The {amount} runtime placeholder was removed from the French translation."
              }
            },
            {
              "id": "glossary-violation",
              "shortDescription": {
                "text": "The checkout term conflicts with the project-approved Mexican Spanish glossary."
              }
            },
            {
              "id": "wrong-page-lang",
              "shortDescription": {
                "text": "The source page declares a generic language instead of the configured source locale."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "vertical-clipping",
          "level": "error",
          "message": {
            "text": "Devanagari glyph bounds exceed the available line box."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "apps/demo-target/data/layout.json"
                }
              }
            }
          ],
          "properties": {
            "issueId": "BF-VIS-HI-001",
            "locale": "hi-IN",
            "route": "/",
            "confidence": "verified",
            "origin": "GUIDED_DEMO",
            "category": "visual"
          }
        },
        {
          "ruleId": "cta-overflow",
          "level": "error",
          "message": {
            "text": "The German CTA scroll width exceeds its fixed client width."
